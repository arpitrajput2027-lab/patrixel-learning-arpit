      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Lead Enquiry Form').first().json; const raw = $json.output?.[0]?.content?.[0]?.text ?? $json.output_text ?? $json.text ?? $json.message?.content ?? $json.output; let parsed={}; try { parsed=typeof raw === 'string' ? JSON.parse(raw.replace(/^```(?:json)?\\s*/i,'').replace(/```$/,'').trim()) : raw; } catch(e){parsed={classification:'warm',reason:'AI output could not be parsed - needs review',reply:'Thank you for your enquiry. We will get back to you soon.'};} const klass=String(parsed?.classification||'warm').toLowerCase(); return {json:{name:String(lead.name||''),email:String(lead.email||''),message:String(lead.message||''),classification:['hot','warm','cold'].includes(klass)?klass:'warm',reason:String(parsed.reason||'Manual review required'),reply:String(parsed.reply||'Thank you for your enquiry. We will get back to you soon.'),submittedAt:String(lead.submittedAt||new Date().toISOString())}};"
      },
